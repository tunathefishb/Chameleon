// Chameleon TUI Theme Configuration (JSON5)
// Place this file at ~/.config/chameleon/theme.json5 or in your project root as theme.json5.
// Supports comments (//, /* */), trailing commas, and unquoted keys.
{
  // Panel & Border Styling
  border_active: "39",        // Vibrant Cyan/Blue (ANSI 256 or hex "#00d7ff")
  border_inactive: "240",      // Dim Gray
  title_active: "39",
  title_inactive: "245",

  // Accent & Highlight
  accent_color: "39",

  // Telemetry Table Styling
  table_header_border: "240",
  table_selected_fg: "229",    // Cream White
  table_selected_bg: "57",     // Deep Purple

  // Footer Navigation Bar
  footer_key: "39",
  footer_desc: "244",
  footer_sep: "238",

  // Job Queue Status Badges
  status_running: "39",        // Cyan
  status_paused: "220",        // Yellow
  status_stopped: "196",       // Red
  status_done: "46",           // Green
  status_error: "196",         // Red
  status_queued: "244",        // Dim Gray
}
